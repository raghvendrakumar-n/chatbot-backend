# Copy this file to .env and fill in your values.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of allowed CORS origins (the Angular dev server, etc.)
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Absolute base URL of this backend, used to build media (logo) URLs when the
# frontend is served from a different origin. Leave blank to derive per-request.
PUBLIC_BASE_URL=

# --- MySQL database ---
DB_NAME=chatbot
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- OpenAI (general hospital Q&A) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# --- Groq (Whisper speech-to-text) ---
GROQ_API_KEY=
GROQ_WHISPER_URL=https://api.groq.com/openai/v1/audio/transcriptions
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# HIMS URL / org / credentials / tokens are configured in the admin UI
# and stored in the database (not in this file).
